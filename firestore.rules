rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGlobalAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'fluryfogue@gmail.com';
    }

    function isCompanyOwner(companyId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function isCompanyMember(companyId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.memberUids ||
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
        );
    }

    function hasActiveMemberRecord(companyId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.active == true;
    }

    function isCompanyAdmin(companyId) {
      return isCompanyOwner(companyId) ||
        isGlobalAdmin() ||
        (hasActiveMemberRecord(companyId) &&
         get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.roleCode == 'admin');
    }

    function canCompanyWrite(companyId) {
      return isCompanyOwner(companyId) ||
        isGlobalAdmin() ||
        (hasActiveMemberRecord(companyId) &&
         get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.canWrite == true);
    }

    function canCompanyDelete(companyId) {
      return isCompanyOwner(companyId) ||
        isGlobalAdmin() ||
        (hasActiveMemberRecord(companyId) &&
         get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.canDelete == true);
    }

    function isValidMemberList(listVal) {
      return listVal is list && listVal.size() >= 1 && listVal.size() <= 50 && listVal[0] is string;
    }

    function isValidLinesList(listVal) {
      return listVal is list && listVal.size() >= 1 && listVal.size() <= 50;
    }

    // Health check document for connection validation
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // 3. Users (PII isolated strictly to owner)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'defaultCompanyId', 'language', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('defaultCompanyId' in data) || (data.defaultCompanyId is string && data.defaultCompanyId.size() <= 128)) &&
        (!('language' in data) || (data.language in ['fr', 'en'])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isGlobalAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultCompanyId', 'language', 'updatedAt']);
      allow delete: if false;
    }

    // 4. Companies (Multi-company root tenant)
    function isValidCompany(data) {
      return data.keys().hasAll(['name', 'currency', 'accountingStandard', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'legalForm', 'taxId', 'rccm', 'currency', 'accountingStandard', 'address', 'phone', 'email', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        (!('legalForm' in data) || (data.legalForm is string && data.legalForm.size() <= 60)) &&
        (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 80)) &&
        (!('rccm' in data) || (data.rccm is string && data.rccm.size() <= 80)) &&
        data.currency in ['XAF', 'XOF', 'EUR', 'USD'] &&
        data.accountingStandard in ['OHADA', 'GENERAL'] &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        isValidMemberList(data.memberUids) &&
        data.ownerId in data.memberUids &&
        data.isDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /companies/{companyId} {
      allow get: if isVerifiedUser() && isValidId(companyId) &&
        (request.auth.uid in existing().memberUids || existing().ownerId == request.auth.uid || isGlobalAdmin());
      allow list: if isVerifiedUser() &&
        (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(companyId) &&
        isValidCompany(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(companyId) &&
        isValidCompany(incoming()) &&
        (existing().ownerId == request.auth.uid || isGlobalAdmin()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'legalForm', 'taxId', 'rccm', 'currency', 'accountingStandard', 'address', 'phone', 'email', 'memberUids', 'isDemo', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(companyId) &&
        (existing().ownerId == request.auth.uid || isGlobalAdmin());

      // 4.1 Company Members (RBAC)
      function isValidMember(data) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'roleCode', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'active', 'ownerId', 'memberUids', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['uid', 'email', 'displayName', 'roleCode', 'departmentName', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'active', 'ownerId', 'memberUids', 'createdAt', 'updatedAt']) &&
          data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
          data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
          data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
          data.roleCode in ['admin', 'direction', 'commercial', 'comptable', 'magasinier', 'rh', 'lecture'] &&
          (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 100)) &&
          data.allowedModules is list && data.allowedModules.size() >= 1 && data.allowedModules.size() <= 20 && data.allowedModules[0] is string &&
          data.canWrite is bool &&
          data.canValidate is bool &&
          data.canDelete is bool &&
          data.active is bool &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      match /members/{memberId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(memberId) &&
          (request.auth.uid == memberId || isCompanyMember(companyId));
        allow list: if isVerifiedUser() &&
          (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(memberId) &&
          isValidMember(incoming()) &&
          incoming().uid == memberId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isCompanyAdmin(companyId) || (isCompanyOwner(companyId) && memberId == request.auth.uid));
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(memberId) &&
          isValidMember(incoming()) &&
          isCompanyAdmin(companyId) &&
          incoming().uid == existing().uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roleCode', 'departmentName', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'active', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(memberId) &&
          isCompanyAdmin(companyId) && memberId != existing().ownerId;
      }

      // 4.2 Departments
      function isValidDepartment(data) {
        return data.keys().hasAll(['code', 'name', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['code', 'name', 'managerName', 'budget', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.code is string && data.code.size() >= 1 && data.code.size() <= 30 &&
          data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
          (!('managerName' in data) || (data.managerName is string && data.managerName.size() <= 120)) &&
          (!('budget' in data) || (data.budget is number && data.budget >= 0)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      match /departments/{deptId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(deptId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(deptId) &&
          isValidDepartment(incoming()) && isCompanyAdmin(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(deptId) &&
          isValidDepartment(incoming()) && isCompanyAdmin(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'managerName', 'budget', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(deptId) && isCompanyAdmin(companyId);
      }

      // 4.3 Role Definitions
      function isValidRole(data) {
        return data.keys().hasAll(['code', 'name', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'ownerId', 'memberUids', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['code', 'name', 'description', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'ownerId', 'memberUids', 'createdAt', 'updatedAt']) &&
          data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
          data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
          (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
          data.allowedModules is list && data.allowedModules.size() >= 1 && data.allowedModules.size() <= 20 && data.allowedModules[0] is string &&
          data.canWrite is bool && data.canValidate is bool && data.canDelete is bool &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /roles/{roleId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(roleId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(roleId) &&
          isValidRole(incoming()) && isCompanyAdmin(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(roleId) &&
          isValidRole(incoming()) && isCompanyAdmin(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'allowedModules', 'canWrite', 'canValidate', 'canDelete', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(roleId) && isCompanyAdmin(companyId);
      }

      // 4.4 Immutable Audit Logs
      function isValidAuditLog(data) {
        return data.keys().hasAll(['userId', 'userEmail', 'action', 'module', 'summary', 'ownerId', 'memberUids', 'createdAt']) &&
          data.keys().hasOnly(['userId', 'userEmail', 'action', 'module', 'entityType', 'entityId', 'summary', 'ownerId', 'memberUids', 'createdAt']) &&
          data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
          data.userEmail is string && data.userEmail.size() <= 200 &&
          data.action is string && data.action.size() >= 1 && data.action.size() <= 60 &&
          data.module is string && data.module.size() >= 1 && data.module.size() <= 60 &&
          (!('entityType' in data) || (data.entityType is string && data.entityType.size() <= 60)) &&
          (!('entityId' in data) || (data.entityId is string && data.entityId.size() <= 128)) &&
          data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.createdAt is timestamp;
      }

      match /auditLogs/{logId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(logId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(logId) &&
          isValidAuditLog(incoming()) && isCompanyMember(companyId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(logId) && isCompanyOwner(companyId);
      }

      // 4.5 CRM: Leads
      function isValidLead(data) {
        return data.keys().hasAll(['name', 'status', 'estimatedValue', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['name', 'companyName', 'email', 'phone', 'source', 'status', 'estimatedValue', 'notes', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
          (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 160)) &&
          (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
          (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
          (!('source' in data) || (data.source is string && data.source.size() <= 60)) &&
          data.status in ['nouveau', 'contacte', 'qualifie', 'converti', 'perdu'] &&
          data.estimatedValue is number && data.estimatedValue >= 0 &&
          (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /leads/{leadId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(leadId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(leadId) &&
          isValidLead(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(leadId) &&
          isValidLead(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'companyName', 'email', 'phone', 'source', 'status', 'estimatedValue', 'notes', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(leadId) && canCompanyDelete(companyId);
      }

      // 4.6 CRM: Customers
      function isValidCustomer(data) {
        return data.keys().hasAll(['code', 'name', 'segment', 'balanceDue', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['code', 'name', 'segment', 'email', 'phone', 'address', 'taxId', 'creditLimit', 'balanceDue', 'leadId', 'notes', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
          data.segment in ['B2B', 'B2C', 'Administration'] &&
          (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
          (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
          (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
          (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 80)) &&
          (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0)) &&
          data.balanceDue is number &&
          (!('leadId' in data) || (data.leadId is string && data.leadId.size() <= 128)) &&
          (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /customers/{customerId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(customerId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(customerId) &&
          isValidCustomer(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(customerId) &&
          isValidCustomer(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'segment', 'email', 'phone', 'address', 'taxId', 'creditLimit', 'balanceDue', 'notes', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(customerId) && canCompanyDelete(companyId);
      }

      // 4.7 CRM: Opportunities
      function isValidOpportunity(data) {
        return data.keys().hasAll(['title', 'stage', 'amount', 'probability', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['title', 'customerId', 'customerName', 'stage', 'amount', 'probability', 'expectedCloseDate', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
          (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128)) &&
          (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160)) &&
          data.stage in ['prospection', 'qualification', 'proposition', 'negociation', 'gagnee', 'perdue'] &&
          data.amount is number && data.amount >= 0 &&
          data.probability is number && data.probability >= 0 && data.probability <= 100 &&
          (!('expectedCloseDate' in data) || (data.expectedCloseDate is string && data.expectedCloseDate.size() <= 30)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /opportunities/{oppId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(oppId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(oppId) &&
          isValidOpportunity(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(oppId) &&
          isValidOpportunity(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'customerId', 'customerName', 'stage', 'amount', 'probability', 'expectedCloseDate', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(oppId) && canCompanyDelete(companyId);
      }

      // 4.8 CRM: Interactions
      function isValidInteraction(data) {
        return data.keys().hasAll(['entityType', 'entityId', 'channel', 'summary', 'date', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.keys().hasOnly(['entityType', 'entityId', 'entityName', 'channel', 'summary', 'date', 'authorEmail', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.entityType in ['lead', 'customer', 'opportunity'] &&
          data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
          (!('entityName' in data) || (data.entityName is string && data.entityName.size() <= 160)) &&
          data.channel in ['appel', 'email', 'reunion', 'note'] &&
          data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 800 &&
          data.date is string && data.date.size() <= 30 &&
          (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 200)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp;
      }

      match /interactions/{interactionId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(interactionId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(interactionId) &&
          isValidInteraction(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(interactionId) && canCompanyDelete(companyId);
      }

      // 4.9 Stocks: Categories
      function isValidCategory(data) {
        return data.keys().hasAll(['code', 'name', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['code', 'name', 'description', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.code is string && data.code.size() >= 1 && data.code.size() <= 30 &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
          (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /categories/{categoryId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(categoryId) && isCompanyMember(companyId);
