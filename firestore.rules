          data.status in ['en_attente', 'partielle', 'payee'] &&
          data.total is number && data.total >= 0 &&
          data.paidAmount is number && data.paidAmount >= 0 &&
          data.balanceDue is number && data.balanceDue >= 0 &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /supplierInvoices/{sinvId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(sinvId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(sinvId) &&
          isValidSupplierInvoice(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(sinvId) &&
          isValidSupplierInvoice(incoming()) && canCompanyWrite(companyId) &&
          (existing().status != 'payee' || isCompanyAdmin(companyId)) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAmount', 'balanceDue', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(sinvId) && canCompanyDelete(companyId);
      }

      // 4.20 Comptabilité: Chart of Accounts (OHADA)
      function isValidAccount(data) {
        return data.keys().hasAll(['code', 'name', 'classNumber', 'type', 'balanceDebit', 'balanceCredit', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['code', 'name', 'classNumber', 'type', 'balanceDebit', 'balanceCredit', 'isSystem', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.code is string && data.code.size() >= 2 && data.code.size() <= 20 &&
          data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
          data.classNumber is number && data.classNumber >= 1 && data.classNumber <= 8 &&
          data.type in ['actif', 'passif', 'charge', 'produit'] &&
          data.balanceDebit is number && data.balanceCredit is number &&
          (!('isSystem' in data) || data.isSystem is bool) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /accounts/{accountId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) &&
          isValidAccount(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) &&
          isValidAccount(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'balanceDebit', 'balanceCredit', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) && canCompanyDelete(companyId);
      }

      // 4.21 Comptabilité: Journal Entries (Strict Double-Entry Balance)
      function isValidJournalEntry(data) {
        return data.keys().hasAll(['number', 'date', 'journalCode', 'label', 'lines', 'totalDebit', 'totalCredit', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.keys().hasOnly(['number', 'date', 'journalCode', 'reference', 'label', 'lines', 'totalDebit', 'totalCredit', 'sourceModule', 'sourceId', 'status', 'authorEmail', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.number is string && data.number.size() >= 1 && data.number.size() <= 60 &&
          data.date is string && data.date.size() <= 30 &&
          data.journalCode in ['VE', 'AC', 'BQ', 'CA', 'OD'] &&
          (!('reference' in data) || (data.reference is string && data.reference.size() <= 80)) &&
          data.label is string && data.label.size() >= 1 && data.label.size() <= 240 &&
          data.lines is list && data.lines.size() >= 2 && data.lines.size() <= 30 && data.lines[0] is map &&
          data.totalDebit is number && data.totalCredit is number &&
          data.totalDebit > 0 &&
          (data.totalDebit - data.totalCredit) < 0.01 &&
          (data.totalCredit - data.totalDebit) < 0.01 &&
          (!('sourceModule' in data) || (data.sourceModule is string && data.sourceModule.size() <= 60)) &&
          (!('sourceId' in data) || (data.sourceId is string && data.sourceId.size() <= 128)) &&
          (!('status' in data) || (data.status in ['validee'])) &&
          (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 200)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp;
      }

      match /journalEntries/{entryId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(entryId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(entryId) &&
          isValidJournalEntry(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(entryId) && canCompanyDelete(companyId);
      }

      // 4.22 Trésorerie: Bank Accounts & Cash Registers
      function isValidTreasuryAccount(data) {
        return data.keys().hasAll(['name', 'type', 'accountCode', 'balance', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['name', 'type', 'bankName', 'iban', 'accountCode', 'balance', 'currency', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
          data.type in ['banque', 'caisse'] &&
          (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120)) &&
          (!('iban' in data) || (data.iban is string && data.iban.size() <= 80)) &&
          data.accountCode is string && data.accountCode.size() >= 2 && data.accountCode.size() <= 20 &&
          data.balance is number &&
          (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /treasuryAccounts/{accountId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) &&
          isValidTreasuryAccount(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) &&
          isValidTreasuryAccount(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bankName', 'iban', 'balance', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(accountId) && canCompanyDelete(companyId);
      }

      // 4.23 Trésorerie: Payments
      function isValidPayment(data) {
        return data.keys().hasAll(['number', 'direction', 'partnerType', 'partnerName', 'treasuryAccountId', 'method', 'amount', 'date', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.keys().hasOnly(['number', 'direction', 'partnerType', 'partnerId', 'partnerName', 'invoiceId', 'invoiceNumber', 'treasuryAccountId', 'treasuryAccountName', 'method', 'amount', 'date', 'reference', 'note', 'ownerId', 'memberUids', 'isDemo', 'createdAt']) &&
          data.number is string && data.number.size() >= 1 && data.number.size() <= 60 &&
          data.direction in ['encaissement', 'decaissement'] &&
          data.partnerType in ['client', 'fournisseur', 'autre'] &&
          (!('partnerId' in data) || (data.partnerId is string && data.partnerId.size() <= 128)) &&
          data.partnerName is string && data.partnerName.size() >= 1 && data.partnerName.size() <= 160 &&
          (!('invoiceId' in data) || (data.invoiceId is string && data.invoiceId.size() <= 128)) &&
          (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 60)) &&
          data.treasuryAccountId is string && data.treasuryAccountId.size() >= 1 && data.treasuryAccountId.size() <= 128 &&
          (!('treasuryAccountName' in data) || (data.treasuryAccountName is string && data.treasuryAccountName.size() <= 140)) &&
          data.method in ['virement', 'especes', 'cheque', 'mobile_money'] &&
          data.amount is number && data.amount > 0 &&
          data.date is string && data.date.size() <= 30 &&
          (!('reference' in data) || (data.reference is string && data.reference.size() <= 80)) &&
          (!('note' in data) || (data.note is string && data.note.size() <= 400)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp;
      }

      match /payments/{paymentId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(paymentId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(paymentId) &&
          isValidPayment(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(paymentId) && canCompanyDelete(companyId);
      }

      // 4.24 Ressources Humaines: Employees
      function isValidEmployee(data) {
        return data.keys().hasAll(['matricule', 'firstName', 'lastName', 'departmentName', 'position', 'contractType', 'baseSalary', 'status', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['matricule', 'firstName', 'lastName', 'email', 'phone', 'departmentId', 'departmentName', 'position', 'contractType', 'hireDate', 'baseSalary', 'status', 'history', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.matricule is string && data.matricule.size() >= 1 && data.matricule.size() <= 40 &&
          data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 80 &&
          data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 80 &&
          (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
          (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
          (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 128)) &&
          data.departmentName is string && data.departmentName.size() <= 120 &&
          data.position is string && data.position.size() <= 120 &&
          data.contractType in ['CDI', 'CDD', 'Stage', 'Consultant'] &&
          (!('hireDate' in data) || (data.hireDate is string && data.hireDate.size() <= 30)) &&
          data.baseSalary is number && data.baseSalary >= 0 &&
          data.status in ['actif', 'en_conge', 'suspendu', 'sorti'] &&
          (!('history' in data) || (data.history is list && data.history.size() <= 30)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /employees/{employeeId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(employeeId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(employeeId) &&
          isValidEmployee(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(employeeId) &&
          isValidEmployee(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'departmentId', 'departmentName', 'position', 'contractType', 'baseSalary', 'status', 'history', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(employeeId) && canCompanyDelete(companyId);
      }

      // 4.25 Ressources Humaines: Leaves & Absences
      function isValidLeave(data) {
        return data.keys().hasAll(['employeeId', 'employeeName', 'type', 'startDate', 'endDate', 'days', 'status', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['employeeId', 'employeeName', 'type', 'startDate', 'endDate', 'days', 'reason', 'status', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 128 &&
          data.employeeName is string && data.employeeName.size() <= 160 &&
          data.type in ['conge_paye', 'maladie', 'absence', 'exceptionnel'] &&
          data.startDate is string && data.startDate.size() <= 30 &&
          data.endDate is string && data.endDate.size() <= 30 &&
          data.days is number && data.days > 0 && data.days <= 365 &&
          (!('reason' in data) || (data.reason is string && data.reason.size() <= 400)) &&
          data.status in ['en_attente', 'approuve', 'refuse'] &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /leaves/{leaveId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(leaveId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(leaveId) &&
          isValidLeave(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(leaveId) &&
          isValidLeave(incoming()) && canCompanyWrite(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reason', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(leaveId) && canCompanyDelete(companyId);
      }

      // 4.26 Ressources Humaines: Payrolls
      function isValidPayroll(data) {
        return data.keys().hasAll(['period', 'employeeId', 'employeeName', 'baseSalary', 'netSalary', 'status', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['period', 'employeeId', 'employeeName', 'departmentName', 'baseSalary', 'bonuses', 'deductions', 'netSalary', 'status', 'paidAt', 'ownerId', 'memberUids', 'isDemo', 'createdAt', 'updatedAt']) &&
          data.period is string && data.period.size() >= 4 && data.period.size() <= 20 &&
          data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 128 &&
          data.employeeName is string && data.employeeName.size() <= 160 &&
          (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 120)) &&
          data.baseSalary is number && data.baseSalary >= 0 &&
          (!('bonuses' in data) || (data.bonuses is number && data.bonuses >= 0)) &&
          (!('deductions' in data) || (data.deductions is number && data.deductions >= 0)) &&
          data.netSalary is number && data.netSalary >= 0 &&
          data.status in ['brouillon', 'validee', 'payee'] &&
          (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 40)) &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.isDemo is bool &&
          data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      match /payrolls/{payrollId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(payrollId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(payrollId) &&
          isValidPayroll(incoming()) && canCompanyWrite(companyId) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(payrollId) &&
          isValidPayroll(incoming()) && canCompanyWrite(companyId) &&
          (existing().status != 'payee' || isCompanyAdmin(companyId)) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['bonuses', 'deductions', 'netSalary', 'status', 'paidAt', 'memberUids', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(payrollId) && canCompanyDelete(companyId);
      }

      // 4.27 Notifications
      function isValidNotification(data) {
        return data.keys().hasAll(['title', 'message', 'severity', 'module', 'read', 'ownerId', 'memberUids', 'createdAt']) &&
          data.keys().hasOnly(['title', 'message', 'severity', 'module', 'read', 'ownerId', 'memberUids', 'createdAt']) &&
          data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
          data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
          data.severity in ['info', 'warning', 'success', 'error'] &&
          data.module is string && data.module.size() >= 1 && data.module.size() <= 60 &&
          data.read is bool &&
          data.ownerId is string && data.ownerId.size() <= 128 &&
          isValidMemberList(data.memberUids) &&
          data.createdAt is timestamp;
      }

      match /notifications/{notifId} {
        allow get: if isVerifiedUser() && isValidId(companyId) && isValidId(notifId) && isCompanyMember(companyId);
        allow list: if isVerifiedUser() && (request.auth.uid in resource.data.memberUids || resource.data.ownerId == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(companyId) && isValidId(notifId) &&
          isValidNotification(incoming()) && isCompanyMember(companyId) &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() && isValidId(companyId) && isValidId(notifId) &&
          isValidNotification(incoming()) && isCompanyMember(companyId) &&
          incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'memberUids']);
        allow delete: if isVerifiedUser() && isValidId(companyId) && isValidId(notifId) && isCompanyMember(companyId);
      }
    }
  }
}
